# Post joylaydigan bot tokeni (@BotFather). Bot @Maxsavdo_0 kanalida
# "Post messages" huquqiga ega ADMIN bo'lishi shart, aks holda 403 qaytadi.
TELEGRAM_BOT_TOKEN=

# Matn generatsiyasi — console.groq.com (bepul tarif yetadi)
GROQ_API_KEY=

# Rasm generatsiyasi — huggingface.co/settings/tokens (read huquqi yetarli)
HF_API_TOKEN=

# Sizning shaxsiy chat ID'ingiz. Bilish uchun: botni ishga tushiring va unga /whoami yozing.
# Xato va hisobotlar shu chatga keladi.
ADMIN_CHAT_ID=

# Kanal username (@ bilan)
CHANNEL=@Maxsavdo_0

# true  — tayyor post kanalga emas, adminga yuboriladi (ko'rib chiqib forward qilasiz)
# false — to'g'ridan-to'g'ri kanalga joylanadi
# Birinchi hafta true qilib turing: AI matni brend ohangiga mos kelishini ko'rib oling.
REVIEW_MODE=true
