# true (значение по умолчанию): corepack переключает pnpm на версию из
# package.json → packageManager. Раньше здесь стоял false — это глушило
# единственный механизм, который замечал расхождение между packageManager
# (11.12.0) и pnpm, который реально стоял в CI (9). Под pnpm 9 overrides
# читались из package.json, а не из pnpm-workspace.yaml, и 35 security-
# оверрайдов не применялись (issue #10). Не выключать снова.
manage-package-manager-versions=true
