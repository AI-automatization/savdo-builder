# API backend (Railway production)
NEXT_PUBLIC_API_URL=https://savdo-api-production.up.railway.app

# Telegram bot username (без @)
NEXT_PUBLIC_BOT_USERNAME=maxsavdo_bot

# Публичный URL лендинга (для SEO / sitemap / OG)
NEXT_PUBLIC_SITE_URL=https://maxsavdo.uz

# --- SEO: подтверждение владения доменом ---
# Коды выдают сами вебмастер-панели. Пока переменная не задана — meta-тег не рендерится.
# Google Search Console → Settings → Ownership verification → HTML tag
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Яндекс.Вебмастер → Настройки → Права доступа → Мета-тег
# NEXT_PUBLIC_YANDEX_VERIFICATION=
# Bing Webmaster Tools (важно: веб-поиск ChatGPT опирается на индекс Bing)
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Аналитика (без ID скрипты не подключаются вообще) ---
# GA4 measurement ID, вида G-XXXXXXXXXX
# NEXT_PUBLIC_GA_ID=
# Яндекс.Метрика — номер счётчика (только цифры)
# NEXT_PUBLIC_YANDEX_METRICA_ID=

# Опционально: умолч. язык
# NEXT_PUBLIC_DEFAULT_LOCALE=uz
